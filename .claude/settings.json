{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.prod)",
      "Read(.env.development)",
      "Read(.env.dev)",
      "Read(.env.test)",
      "Read(.env.testing)",
      "Read(.env.staging)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.testing)",
      "Read(**/.env.staging)",
      "Read(*.pem)",
      "Read(**/*.pem)",
      "Read(*.key)",
      "Read(**/*.key)",
      "Read(*.p12)",
      "Read(**/*.p12)",
      "Read(*.pfx)",
      "Read(**/*.pfx)",
      "Read(*.cer)",
      "Read(**/*.cer)",
      "Read(*.crt)",
      "Read(**/*.crt)",
      "Read(id_rsa)",
      "Read(**/id_rsa)",
      "Read(id_ed25519)",
      "Read(**/id_ed25519)",
      "Read(id_dsa)",
      "Read(**/id_dsa)",
      "Read(id_ecdsa)",
      "Read(**/id_ecdsa)",
      "Read(credentials.json)",
      "Read(**/credentials.json)",
      "Read(secrets.json)",
      "Read(**/secrets.json)",
      "Read(secret.json)",
      "Read(**/secret.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-gstack.sh\""
          }
        ]
      }
    ]
  }
}
